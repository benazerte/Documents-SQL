# Generate a unique value with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_PATH=./data/nexora.db
# Optional seed command: use your own development identity, never production credentials.
# SEED_EMAIL=
# SEED_PASSWORD=
# SEED_NAME=

# Disable framework development/build telemetry.
NEXT_TELEMETRY_DISABLED=1

# Enable only behind a private reverse proxy that REPLACES x-forwarded-for.
TRUST_PROXY_HEADERS=false
